{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "rootDir": ".",
    "types": [
      "node"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "sourceMap": false,
    "noEmit": true
  },
  "include": [
    "electron/**/*.cts"
  ]
}
